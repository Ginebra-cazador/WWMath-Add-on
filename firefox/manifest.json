{
  "manifest_version": 2,
  "name": "Unofficial WWM Calculator Data Patch",
  "version": "3.3.8",
  "description": "Locally updates configurable levels, gear, tuning, and Martial Arts data on the Where Winds Math calculator.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "https://wherewindsmath.pages.dev/*"
  ],
  "background": {
    "scripts": ["config.js", "patch-core.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://wherewindsmath.pages.dev/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{929d8bea-c146-47cd-ad54-da4ccf748f2d}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
